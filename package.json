{
  "name": "power-view-for-jira",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A Chrome extension for advanced Jira planning views and explicit editing.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm clean && pnpm --filter @power-view/web build && pnpm --filter @power-view/extension build && pnpm validate:extension && pnpm package:extension",
    "clean": "node scripts/clean.mjs",
    "dev": "pnpm --parallel --filter @power-view/web --filter @power-view/extension dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "package:extension": "node scripts/package-extension.mjs",
    "package:enterprise": "node scripts/package-enterprise-update.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "pnpm typecheck:root && pnpm -r --if-present typecheck",
    "typecheck:root": "tsc --noEmit",
    "validate:extension": "node scripts/validate-extension.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "crx3": "^2.0.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
